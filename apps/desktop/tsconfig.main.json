{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/main",
    "src/profiles",
    "src/diagnostics",
    "src/certificates",
    "src/proxmox",
    "src/storage",
    "src/shared",
    "src/ai",
    "src/ssh",
    "src/terminal"
  ],
  "exclude": ["src/renderer"]
}
