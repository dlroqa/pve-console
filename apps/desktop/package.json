{
  "name": "pve-console-desktop",
  "version": "1.3.0",
  "private": true,
  "description": "PVE Console desktop application (Electron + React + TypeScript + Vite).",
  "desktopName": "pve-console",
  "homepage": "https://github.com/dlroqa/pve-console",
  "author": {
    "name": "PVE Console",
    "email": "pve-console@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n vite,main,electron -c cyan,yellow,green \"vite\" \"tsc -w -p tsconfig.main.json --preserveWatchOutput\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package": "npm run build && npm run package:dist",
    "package:dist": "electron-builder --config electron-builder.yml --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.6",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.1"
  }
}
